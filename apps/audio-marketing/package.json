{
  "name": "@web-kits/audio-marketing",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm bake && pnpm music && remotion studio",
    "studio": "remotion studio",
    "bake": "tsx scripts/bake-sounds.ts",
    "music": "tsx scripts/generate-music.ts",
    "prebuild": "pnpm bake && pnpm music",
    "build": "remotion bundle",
    "render": "pnpm bake && pnpm music && remotion render Marketing out/launch-video.mp4 --codec=h264 --concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/motion-blur": "^4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/transitions": "^4.0.541",
    "@web-kits/audio": "workspace:^",
    "@web-kits/ui": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "css-loader": "^7.1.5",
    "node-web-audio-api": "^1.0.9",
    "style-loader": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
