{
  "name": "web-kits",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome ci . && prettier --check \"**/*.mdx\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "smoke": "bash scripts/smoke-packages.sh",
    "prepare": "husky",
    "format": "biome check --write . && prettier --write \"**/*.mdx\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@web-kits/audio": "workspace:^",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  }
}
