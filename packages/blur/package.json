{
  "name": "@web-kits/blur",
  "version": "0.1.0",
  "description": "Apple's progressive blur from the iOS 27 scroll edge, measured in the Simulator and rebuilt with backdrop-filter.",
  "license": "MIT",
  "author": "Raphael Salaja",
  "homepage": "https://www.raphaelsalaja.com/work/progressive-blur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/web-kits.git",
    "directory": "packages/blur"
  },
  "bugs": "https://github.com/raphaelsalaja/web-kits/issues",
  "keywords": [
    "progressive blur",
    "variable blur",
    "backdrop-filter",
    "scroll edge",
    "ios",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:ts7"
  }
}
