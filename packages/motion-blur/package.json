{
  "name": "@web-kits/motion-blur",
  "version": "0.1.0",
  "description": "Motion blur for moving DOM elements, sized from speed, frame time and shutter angle.",
  "license": "MIT",
  "author": "Raphael Salaja",
  "homepage": "https://www.raphaelsalaja.com/work/motion-blur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/web-kits.git",
    "directory": "packages/motion-blur"
  },
  "bugs": "https://github.com/raphaelsalaja/web-kits/issues",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "motion blur",
    "animation",
    "css",
    "react",
    "echo",
    "shutter"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:ts7"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
