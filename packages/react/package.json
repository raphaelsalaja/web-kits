{
  "name": "@web-kits/react",
  "version": "0.0.0",
  "private": true,
  "description": "React components that move the way iOS does: SwiftUI's and Family's text and number transitions, measured from the real thing.",
  "license": "MIT",
  "author": "Raphael Salaja",
  "homepage": "https://web-kits.dev/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/web-kits.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/raphaelsalaja/web-kits/issues",
  "keywords": [
    "react",
    "swiftui",
    "numeric text",
    "content transition",
    "number animation",
    "text animation",
    "spring"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./number-transition": "./src/number-transition.tsx",
    "./text-transition": "./src/text-transition.tsx",
    "./springs": "./src/springs.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./number-transition": {
        "types": "./dist/number-transition.d.ts",
        "default": "./dist/number-transition.js"
      },
      "./text-transition": {
        "types": "./dist/text-transition.d.ts",
        "default": "./dist/text-transition.js"
      },
      "./springs": {
        "types": "./dist/springs.d.ts",
        "default": "./dist/springs.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
