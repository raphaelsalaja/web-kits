{
  "name": "@web-kits/react",
  "version": "0.0.0",
  "private": true,
  "description": "React components that move the way iOS does: SwiftUI's and Family's text and number transitions, measured from the real thing.",
  "license": "MIT",
  "author": "Raphael Salaja",
  "homepage": "https://web-kits.dev/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/web-kits.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/raphaelsalaja/web-kits/issues",
  "keywords": [
    "react",
    "swiftui",
    "numeric text",
    "content transition",
    "number animation",
    "text animation",
    "spring"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./animation": "./src/animation/index.ts",
    "./content-transition": "./src/content-transition/index.ts",
    "./family": "./src/family/index.ts",
    "./text-transition": "./src/text-transition/index.ts",
    "./number-transition": "./src/number-transition/index.ts",
    "./motion-blur": "./src/motion-blur/index.ts",
    "./progressive-blur": "./src/progressive-blur/index.ts",
    "./origin": "./src/origin/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./animation": {
        "types": "./dist/animation/index.d.ts",
        "default": "./dist/animation/index.js"
      },
      "./content-transition": {
        "types": "./dist/content-transition/index.d.ts",
        "default": "./dist/content-transition/index.js"
      },
      "./family": {
        "types": "./dist/family/index.d.ts",
        "default": "./dist/family/index.js"
      },
      "./text-transition": {
        "types": "./dist/text-transition/index.d.ts",
        "default": "./dist/text-transition/index.js"
      },
      "./number-transition": {
        "types": "./dist/number-transition/index.d.ts",
        "default": "./dist/number-transition/index.js"
      },
      "./motion-blur": {
        "types": "./dist/motion-blur/index.d.ts",
        "default": "./dist/motion-blur/index.js"
      },
      "./progressive-blur": {
        "types": "./dist/progressive-blur/index.d.ts",
        "default": "./dist/progressive-blur/index.js"
      },
      "./origin": {
        "types": "./dist/origin/index.d.ts",
        "default": "./dist/origin/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
