{
  "source": "UITextView caret in the iOS 27 Simulator, iPhone 18 Pro, read from Core Animation and from the UIKit spring calls that drive it",
  "units": "lengths in points at a 17pt system font; times in seconds",
  "shape": {
    "width": 2,
    "height": 22,
    "wrappedLineHeight": 23,
    "cornerRadius": 0,
    "color": "tint"
  },
  "blink": {
    "period": 1,
    "repeat": "forever",
    "keyTimes": [
      0, 0.5, 0.5375, 0.575, 0.6125, 0.65, 0.85, 0.8875, 0.925, 0.9625, 1
    ],
    "opacity": [1, 1, 0.75, 0.5, 0.25, 0, 0, 0.25, 0.5, 0.75, 1],
    "calculationMode": "discrete",
    "restartsOn": ["selection change", "keystroke"],
    "solidWhileTyping": true,
    "hiddenWithRangeSelection": true
  },
  "programmaticMove": "jump",
  "dropPosition": {
    "spring": { "tension": 400, "friction": 35, "mass": 1 },
    "equivalent": { "response": 0.3142, "dampingRatio": 0.875 },
    "show": { "scale": [2, 1], "opacity": [0, 1] }
  },
  "floatingCursor": {
    "fadeOriginal": { "duration": 0.15, "easing": [0.42, 0, 0.58, 1] },
    "track": { "dampingRatio": 1, "response": 0.18 },
    "settle": { "dampingRatio": 1, "response": 0.18 }
  },
  "bulge": {
    "out": { "scale": 1.1, "duration": 0.18, "bounce": 0.8, "delay": 0 },
    "back": { "scale": 1, "duration": 0.18, "bounce": 0, "delay": 0.13 },
    "peakScale": 1.15,
    "peakAt": 0.1
  }
}
