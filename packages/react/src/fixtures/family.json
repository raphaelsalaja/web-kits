        "model": "a deleted digit drops away on a slow, slightly bouncy spring",
        "spring": {
          "stiffness": 248,
          "dampingRatio": 0.85,
          "duration": 0.399,
          "bounce": 0.15
        },
        "travel": 2.44,
        "units": "cap heights"
      },
      "push": {
        "model": "a digit typed over the 0 shown before typing, or replaced by it, comes in on a softer spring than other typed digits, and the one it replaces leaves on the same spring, far enough to clear the mask",
        "spring": {
          "stiffness": 740,
          "dampingRatio": 0.9
        },
        "travel": 1.5,
        "units": "cap heights",
        "rmsPx": 2.5,
        "method": "both digits of the first press in send-keypad.mp4 and swap.mp4, fitted together"
      },
