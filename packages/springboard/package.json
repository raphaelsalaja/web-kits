{
  "name": "@web-kits/springboard",
  "version": "0.1.0",
  "private": true,
  "description": "Apple's springs, curves and transitions measured from iOS and macOS, with SpringBoard's app launch and the Dock's genie for any DOM element.",
  "license": "MIT",
  "author": "Raphael Salaja",
  "homepage": "https://www.raphaelsalaja.com/work/apple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/web-kits.git",
    "directory": "packages/springboard"
  },
  "bugs": "https://github.com/raphaelsalaja/web-kits/issues",
  "keywords": [
    "spring",
    "animation",
    "ios",
    "macos",
    "genie",
    "app launch",
    "base ui",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@web-kits/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
